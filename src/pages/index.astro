---
// 1. 引入 Astro 的图片组件
import { Image } from 'astro:assets';
// 2. 导入你的数据
import { foods } from "../components/foods";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>美食日记 | ShenWan</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;500;700;900&display=swap");

      body {
        font-family: "Noto Serif SC", serif;
        background-color: #fdfcf9; /* 暖白色背景 */
      }

      /* 弹窗背景毛玻璃 */
      dialog::backdrop {
        backdrop-filter: blur(6px);
        background-color: rgba(0, 0, 0, 0.4);
      }

      /* 隐藏滚动条 */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
    </style>
  </head>
  <body class="min-h-screen text-stone-700 antialiased">
    <nav class="fixed top-6 inset-x-6 z-[100] flex justify-between items-start pointer-events-none">
      <a
        href="https://shenwan.life"
        class="pointer-events-auto group flex items-center gap-2 bg-white/80 backdrop-blur-md px-4 py-2 rounded-full border border-stone-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-stone-600 hover:text-stone-900 no-underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="text-sm font-bold tracking-wide">前往主页</span>
      </a>

      <a
        href="https://github.com/ShenWan0906/FoodDiary"
        target="_blank"
        class="pointer-events-auto group flex items-center gap-2.5 bg-stone-800 hover:bg-stone-900 px-5 py-2 rounded-full shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 text-stone-50 border border-stone-700 no-underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="transition-transform duration-300 group-hover:scale-110" viewBox="0 0 16 16">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span class="text-sm font-semibold tracking-wide">GitHub</span>
      </a>
    </nav>

    <header class="pt-32 pb-16 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6 tracking-[0.2em] text-stone-800 uppercase">
        美食日记
      </h1>
      <p class="text-stone-400 font-light italic tracking-[0.1em] max-w-lg mx-auto px-4">
        记录生活中的每一次美味相遇，用温暖的视角捕捉食物的故事
      </p>
    </header>

    <main class="max-w-7xl mx-auto pb-24 px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {
          foods.map((food, index) => (
            <div class="relative">
              <div
                class="food-card group bg-white rounded-[2rem] overflow-hidden shadow-[0_4px_25px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] transition-all duration-700 cursor-pointer border border-stone-50"
                data-modal-id={`modal_${index}`}
              >
                <div class="relative h-72 overflow-hidden bg-stone-100">
                  <Image
                    src={food.image}
                    alt={food.title}
                    width={600}
                    format="webp"
                    class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                  />
                  <div class="absolute top-5 right-5 bg-white/90 backdrop-blur-md px-4 py-1.5 rounded-full text-[10px] tracking-widest text-stone-500 font-bold shadow-sm">
                    {food.tags[0]}
                  </div>
                </div>
                <div class="p-8">
                  <div class="flex justify-between items-start mb-3">
                    <h2 class="text-2xl font-bold text-stone-800 tracking-tight">
                      {food.title}
                    </h2>
                    <div class="rating rating-xs mt-2">
                      {[...Array(5)].map((_, i) => (
                        <input
                          type="radio"
                          class={`mask mask-star-2 ${i < food.rating ? "bg-[#d4c4b7]" : "bg-stone-100"}`}
                          checked
                          disabled
                        />
                      ))}
                    </div>
                  </div>
                  <p class="text-sm text-stone-500 mb-6 font-light leading-relaxed line-clamp-2">
                    {food.description}
                  </p>

                  <div class="flex flex-wrap gap-2 mb-8">
                    {food.tags.map((tag) => (
                      <span class="bg-[#fcfaf8] border border-stone-100 px-3 py-1 rounded-full text-[10px] text-stone-400 font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <div class="text-[10px] text-stone-300 font-mono italic">
                    {food.date}
                  </div>
                </div>
              </div>

              <dialog id={`modal_${index}`} class="modal modal-bottom sm:modal-middle">
                <div class="modal-box p-0 bg-white rounded-[2.5rem] max-w-2xl overflow-y-auto max-h-[85vh] shadow-2xl relative scrollbar-hide">
                  <div class="relative h-80 sm:h-96 bg-stone-100">
                    <Image
                      src={food.image}
                      alt={food.title}
                      width={1000}
                      format="webp"
                      data-raw-src={food.image.src}
                      class="w-full h-full object-cover cursor-zoom-in zoomable-image transition-opacity hover:opacity-95"
                    />
                    <div class="absolute top-6 left-6 bg-white/90 backdrop-blur-md px-5 py-2 rounded-full text-xs text-stone-600 font-bold tracking-widest uppercase">
                      {food.tags[0]}
                    </div>
                    <form method="dialog">
                      <button class="btn btn-sm btn-circle absolute right-6 top-6 bg-black/10 hover:bg-black/20 border-none text-white text-lg">
                        ✕
                      </button>
                    </form>
                  </div>

                  <div class="p-10 sm:p-14">
                    <div class="mb-10">
                      <div class="flex items-center gap-4 mb-3">
                        <h3 class="font-bold text-4xl text-stone-800">
                          {food.title}
                        </h3>
                        <div class="rating rating-sm">
                          {[...Array(5)].map((_, i) => (
                            <input
                              type="radio"
                              class={`mask mask-star-2 ${i < food.rating ? "bg-[#d4c4b7]" : "bg-stone-100"}`}
                              checked
                              disabled
                            />
                          ))}
                        </div>
                      </div>
                      <p class="text-stone-400 italic text-sm font-light tracking-wide">
                        {food.date}
                      </p>
                    </div>

                    <div class="flex flex-wrap gap-3 mb-10">
                      {food.tags.map((tag) => (
                        <span class="border border-stone-100 bg-[#fcfaf8] px-5 py-1.5 rounded-full text-xs text-stone-500">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <div class="space-y-6 mb-12">
                      <div class="flex items-center gap-4 text-stone-300">
                        <span class="h-[1px] w-8 bg-current" />
                        <h4 class="text-[11px] font-bold uppercase tracking-[0.3em]">
                          故事与风味
                        </h4>
                      </div>
                      <p class="text-stone-500 leading-[2.2] text-[0.95rem] font-light">
                        {food.description}
                      </p>
                    </div>

                    {food.recipe && (
                      <div class="border-t border-stone-100 pt-10 space-y-12">
                        <div>
                          <h4 class="text-xs font-bold text-stone-400 uppercase tracking-[0.3em] mb-6 flex items-center gap-3">
                            <span class="w-1.5 h-1.5 bg-[#d4c4b7] rounded-full" />{" "}
                            食材清单
                          </h4>
                          <div class="grid grid-cols-2 gap-3">
                            {food.recipe.ingredients.map((ing) => (
                              <div class="text-stone-600 text-sm py-2.5 px-4 bg-[#fcfaf8] rounded-xl border border-stone-100/80 font-light">
                                {ing}
                              </div>
                            ))}
                          </div>
                        </div>

                        <div>
                          <h4 class="text-xs font-bold text-stone-400 uppercase tracking-[0.3em] mb-8 flex items-center gap-3">
                            <span class="w-1.5 h-1.5 bg-[#d4c4b7] rounded-full" />{" "}
                            烹饪步骤
                          </h4>
                          <div class="space-y-8">
                            {food.recipe.steps.map((step, sIndex) => (
                              <div class="flex gap-5 items-start">
                                <span class="flex-none w-6 h-6 rounded-full border border-stone-200 text-stone-400 text-[11px] flex items-center justify-center font-mono mt-0.5">
                                  {sIndex + 1}
                                </span>
                                <p class="text-stone-600 text-sm leading-[2] font-light pt-0.5">
                                  {step}
                                </p>
                              </div>
                            ))}
                          </div>
                        </div>

                        <div class="bg-[#fdfcf9] p-8 rounded-[2rem] border border-stone-100 relative">
                          <div class="absolute -top-3 left-8 bg-[#fdfcf9] px-2 text-stone-400 text-xs tracking-widest font-bold">
                            TIPS
                          </div>
                          <p class="text-stone-500 text-sm leading-relaxed font-light italic mt-2">
                            {food.recipe.tips}
                          </p>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                <form method="dialog" class="modal-backdrop">
                  <button>close</button>
                </form>
              </dialog>
            </div>
          ))
        }
      </div>
    </main>

    <footer class="py-16 text-center">
      <div class="h-px w-12 bg-stone-200 mx-auto mb-8"></div>
      <p class="text-stone-400 text-[10px] tracking-[0.4em] uppercase">
        &copy; 2026 SHENWAN.LIFE
      </p>
    </footer>

    <dialog id="image_viewer" class="modal">
      <div class="modal-box max-w-5xl p-0 bg-transparent shadow-none relative overflow-hidden flex justify-center items-center">
        <form method="dialog">
          <button class="btn btn-sm btn-circle absolute right-4 top-4 bg-black/40 hover:bg-black/60 border-none text-white text-lg z-50">✕</button>
        </form>
        <img id="viewer_img" src="" class="max-w-full max-h-[90vh] object-contain rounded-2xl shadow-2xl" />
      </div>
      <form method="dialog" class="modal-backdrop">
        <button class="cursor-zoom-out">close</button>
      </form>
    </dialog>

    <script>
      const setupInteractions = () => {
        // 1. 卡片详情弹窗逻辑
        document.querySelectorAll(".food-card").forEach((card) => {
          card.addEventListener("click", () => {
            const modalId = card.getAttribute("data-modal-id");
            if(modalId) {
              const modal = document.getElementById(modalId) as HTMLDialogElement;
              if (modal) modal.showModal();
            }
          });
        });

        // 2. 图片点击放大逻辑
        const viewer = document.getElementById("image_viewer") as HTMLDialogElement;
        const viewerImg = document.getElementById("viewer_img") as HTMLImageElement;

        document.querySelectorAll(".zoomable-image").forEach((img) => {
          img.addEventListener("click", (e) => {
            e.stopPropagation();
            if (viewer && viewerImg) {
              const targetImg = e.target as HTMLImageElement;
              // 优先读取 data-raw-src 拿原图，没有则降级使用 src
              viewerImg.src = targetImg.getAttribute("data-raw-src") || targetImg.src;
              viewer.showModal();
            }
          });
        });
      };

      setupInteractions();
      document.addEventListener("astro:after-swap", setupInteractions);
    </script>
  </body>
</html>